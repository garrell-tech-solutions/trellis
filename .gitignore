# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# The mutation run's own build cache. Deliberately NOT the normal `target/`:
# cargo-mutants builds a patched copy of the tree, so sharing one target dir
# with ordinary builds leaves mutated artifacts behind that later `cargo test`
# runs link against -- a green suite turning red with a clean `git status`.
target-mutants/

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Generated by cargo llvm-cov
*.profraw
*.profdata

# Generated by the Acceptance Pipeline Specification tools (gherkin-parser,
# gherkin-ir-dry-checker, gherkin-mutator): JSON IR, DRY reports, and mutation
# output derived from features/*.feature. Source of truth is the .feature file.
build/acceptance/
build/acceptance-mutation/
acceptance/generated/

# This project's generated entrypoint dir (scripts/acceptance/generate.bb
# writes here; Cargo auto-discovers tests/*.rs as integration test binaries).
crates/acceptance-tests/tests/*_acceptance.rs
crates/acceptance-tests/tests/metadata/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local SQLite databases. `trellis serve --db trellis.db` and every ad hoc
# poke at the schema leave one of these in the working tree; none of them
# belong in the repo (issue #32).
*.db
*.db-wal
*.db-shm
*.sqlite*

# Scratch. The constitution mandates ./tmp/ for temporary files, so every
# worktree grows one (issue #27).
tmp/

# OS / editor
.DS_Store

# Python bytecode cache (scripts/analyzers/*.py helpers)
__pycache__/

# Secrets and local config
.env
.claude/

# SwarmForge runtime state and worktrees (per-machine, never shared)
.swarmforge/
.worktrees/

# SwarmForge framework scripts are synced from the upstream fork by
# swarmforge/scripts/update-swarmforge.sh, so they are not tracked here.
# Everything else under swarmforge/ IS tracked: the constitution, role prompts,
# and swarmforge.conf are project configuration that the worktrees need, and
# worktrees only receive what git tracks.
swarmforge/scripts/

# proptest writes a seed file next to the crate whenever a property fails, and
# recommends checking it in. Not here: the failures that produce one in this
# repo come from deliberately broken code -- a mutation run, or a guard removed
# to confirm a property is not vacuous -- so the seed records a case that never
# failed against real code. A property worth keeping belongs in the generator
# or in a named example test.
proptest-regressions/
